{
  "manifest_version": 3,
  "name": "Opa! — Speed Vídeos",
  "version": "0.8.3",
  "minimum_chrome_version": "106",
  "description": "Pesquise Speed Vídeos por setor, adicione pastas públicas pessoais do Drive e insira os links no rascunho do atendimento.",
  "permissions": ["storage", "scripting", "clipboardWrite"],
  "host_permissions": ["https://suporte.ixcsoft.com.br/*"],
  "optional_host_permissions": ["https://drive.google.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Speed Vídeos" },
  "options_page": "options.html"
}
